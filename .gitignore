# --- Secrets — never commit a credential -------------------------------
# The Streamlit secrets file holds the personal Anthropic API key.
# Only the real file is ignored; the committed secrets.toml.example
# (placeholder, no key-like value) documents the expected shape.
.streamlit/secrets.toml
**/.streamlit/secrets.toml
.env
.env.*

# --- Python virtual environments ---------------------------------------
.venv/
venv/
env/
ENV/

