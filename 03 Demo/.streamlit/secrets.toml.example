# EXAMPLE FILE — intentionally contains NO real credential and no
# key-like value. It is safe to commit and safe to share.
#
# To use the demo:
#   1. Copy this file to `secrets.toml` in this same `.streamlit` folder.
#   2. Replace the placeholder below with your OWN Anthropic API key from
#      console.anthropic.com (personal, billable — never share it, never
#      commit it, never paste it into a chat).
#
# The real `secrets.toml` is excluded by the repository's `.gitignore`.
# The app treats the placeholder value below as "no key configured".

ANTHROPIC_API_KEY = "PASTE-YOUR-OWN-KEY-HERE"
